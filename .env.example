# JARVIS — example environment file
# ===================================================================
# Copy this file to `.env` in the same folder, pick a brain with
# JARVIS_AI_PROVIDER and fill in that provider's key. Those are the only lines
# you need; everything else is optional and shown with its default. Never
# commit a real key — `.env` and `.env.local` are ignored by git.
#
# Two audiences read these variables:
#   - the BRIDGE (bridge/server.mjs, the Node server) reads everything without
#     a VITE_ prefix. It loads `.env.local` and `.env` itself; values already
#     set in your shell win over both.
#   - the FRONTEND (the Vite app in the browser) reads only VITE_* variables.
#
# Only VITE_-prefixed values ever reach the browser. Never give a secret a
# VITE_ prefix — it would be compiled into the page for anyone to read.


# ===================================================================
# THE BRAIN (bridge only — keys are never sent to the browser)
# ===================================================================

# Which service JARVIS thinks with. Change this one line to switch.
#   openai — OpenAI API key, billed to your OpenAI API credit.
#   gemini — Google AI Studio API key. Has a free tier.
#   vertex — Gemini through a Google Cloud project; billed to Cloud credits
#            (the $300 welcome credit pays for this one, not for AI Studio).
# Default openai.
JARVIS_AI_PROVIDER=openai

# Model calls allowed per question, so a tool loop cannot run away. Default 12.
# JARVIS_MAX_TOOL_STEPS=12

# How many recent exchanges (question + spoken answer) JARVIS remembers.
# Tool output and images are never carried over. 0 = no memory. Default 12.
# JARVIS_HISTORY_TURNS=12


# --- OpenAI (JARVIS_AI_PROVIDER=openai) ---------------------------------

# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The model JARVIS thinks with on OpenAI. Needs a model that supports the
# Responses API and function calling. Default gpt-5-mini.
# OPENAI_MODEL=gpt-5-mini

# Reasoning effort for reasoning models (gpt-5 family, o-series):
# minimal | low | medium | high, or `off` to never send it. Unset means `low`
# for those models — snappier for voice — and omitted for everything else.
# OPENAI_REASONING_EFFORT=

# OpenAI's hosted web search tool. Default true.
# OPENAI_WEB_SEARCH=true

# Cap on each reply's length, in tokens. Default 4096.
# OPENAI_MAX_OUTPUT_TOKENS=4096

# Optional: a proxy or OpenAI-compatible gateway. Default: the OpenAI API.
# OPENAI_BASE_URL=


# --- Gemini, Google AI Studio (JARVIS_AI_PROVIDER=gemini) ----------------

# Create one at https://aistudio.google.com/apikey (starts with "AIza").
# On the free tier Google may use your prompts to improve its products.
# GEMINI_API_KEY=

# The Gemini model. Default gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Reasoning effort: low | medium | high, or `off` to leave it to the model.
# Also used for Vertex AI. Default low (snappier for voice).
# GEMINI_REASONING_EFFORT=low

# Cap on each reply's length, in tokens. Also used for Vertex AI. Default 4096.
# GEMINI_MAX_OUTPUT_TOKENS=4096

# Optional: a proxy for Google's OpenAI-compatible endpoint.
# Default https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_BASE_URL=


# --- Gemini on Vertex AI, Google Cloud (JARVIS_AI_PROVIDER=vertex) -------

# No key here: sign in once with the Google Cloud CLI —
#   gcloud auth application-default login
# and enable the Vertex AI API on a project with billing linked.

# Your Google Cloud project id (not the name). Falls back to GOOGLE_CLOUD_PROJECT.
# VERTEX_PROJECT=

# Region, or `global`. Default global.
# VERTEX_LOCATION=global

# The model, with its publisher prefix. Default google/gemini-3.8-flash.
# VERTEX_MODEL=google/gemini-3.8-flash


# ===================================================================
# VOICE (bridge)
# ===================================================================

# Who speaks and who listens: auto | elevenlabs | openai | browser.
# auto = ElevenLabs when ELEVENLABS_API_KEY is set, otherwise the browser's own
# speech. OpenAI speech is opt-in because it is billed to your OpenAI key.
# Default auto.
# JARVIS_TTS_PROVIDER=auto
# JARVIS_STT_PROVIDER=auto

# ElevenLabs. Optional; a better voice and Scribe transcription.
# ELEVENLABS_API_KEY=
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# The language he listens for and answers in: en or ka (Georgian). In en he
# still answers Georgian with Georgian. Speaking Georgian needs ElevenLabs
# (Georgian sentences use its eleven_v3 model). Default: en.
# JARVIS_LANGUAGE=en

# OpenAI speech, used when a provider above is set to `openai` (needs
# OPENAI_API_KEY whichever brain is in use).
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe


# ===================================================================
# TOOLS AND SAFETY (bridge)
# ===================================================================

# How long JARVIS waits for your yes/no on a confirmation before treating
# silence as no, in milliseconds. Default 30000.
# JARVIS_CONFIRM_TIMEOUT_MS=30000

# Folders JARVIS may list, read text files from, and recycle files from,
# comma separated. `none` turns file access off. Nothing outside these folders
# is reachable, and key/credential files are refused even inside them. New
# folders, copies and new files are made straight away; replacing, moving and
# deleting are confirmed; Windows, Program Files, AppData and JARVIS's own
# folder can't be changed at all.
# Default: every drive.
# JARVIS_READ_ROOTS=

# Whole-PC control: windows, the mouse, typing, keys, volume, media, lock and
# power. Clicks, typing, keys, closing and power ask first; moving the pointer,
# scrolling and the volume do not. Default true.
# JARVIS_PC_CONTROL=true

# The run_command tool: one PowerShell or cmd command at a time, shown to you in
# full and confirmed each time; secrets are kept out of it. It can also run a
# command as administrator, which Windows' UAC prompt confirms as well.
# Default true.
# JARVIS_ALLOW_COMMANDS=true

# JARVIS drives its own Chrome (or Edge) profile, never your everyday one.
# The browser is found automatically; set the path if it is somewhere unusual.
# JARVIS_CHROME_PATH=
# JARVIS_CHROME_PROFILE=          (default ~/.jarvis/chrome-profile)
# JARVIS_CHROME_DEBUG_PORT=9222
# Launch that browser automatically the first time a page tool needs it.
# JARVIS_CHROME_AUTOLAUNCH=true


# ===================================================================
# THE BRIDGE SERVER
# ===================================================================

# Port for the WebSocket and the small HTTP endpoints. Default 8787.
# If you change it, change VITE_BRIDGE_URL to match.
# JARVIS_BRIDGE_PORT=8787

# Extra browser origins allowed to open the WebSocket, comma separated. Local
# dev origins (localhost:5173-5199, 4173-4199) are already allowed. Default: none.
# JARVIS_ALLOWED_ORIGINS=

# Allow clients that send no Origin header at all (curl, scripts). Off by
# default, because that is also what local malware looks like. Default 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra directories the bridge's /file endpoint may serve images from, comma
# separated. Your home directory and the system temp directory are always
# included. Default: none.
# JARVIS_FILE_ROOTS=

# City for the interface's weather readout, e.g. London. Looked up on
# Open-Meteo (free, no key); only the city name leaves your machine.
# Default: none (the panel says SET CITY).
# JARVIS_WEATHER_CITY=

# What JARVIS calls you (blank: "sir"), and standing instructions he keeps in
# mind in every conversation, up to 2000 characters — a language to answer in,
# a tone. They never override confirmations. Both are easier to set on the
# interface's SETTINGS page, which saves them to ~/.jarvis/settings.json.
# JARVIS_USER_NAME=
# JARVIS_INSTRUCTIONS=

# Verbose logging. Default 0.
# JARVIS_DEBUG=0


# ===================================================================
# FRONTEND (Vite) — public settings only, no secrets
# ===================================================================

# Where the bridge listens. Default ws://localhost:8787.
# VITE_BRIDGE_URL=ws://localhost:8787

# Browser text-to-speech engine, used when the bridge has no voice.
#   system — the browser's built-in speechSynthesis. Instant, on-device.
#   kokoro — a neural voice running in the browser. Better sound, slower.
# Default system.
# VITE_TTS_ENGINE=system

# Which Kokoro voice, when VITE_TTS_ENGINE=kokoro. Default bm_george.
# VITE_KOKORO_VOICE=bm_george

# Always prefer the bridge's voice even if it did not advertise one.
# Default false.
# VITE_USE_ELEVENLABS=false

# Picovoice AccessKey for the offline "Jarvis" wake word. These keys are made
# for client-side use. Without one, the browser's speech recogniser listens for
# "Hey Jarvis" instead. Default: none.
# VITE_PICOVOICE_ACCESS_KEY=

# The look. command = the green holographic command centre; classic = the
# original cyan HUD. Default command.
# VITE_JARVIS_HUD=command
